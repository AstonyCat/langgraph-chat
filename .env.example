# Set your API key to use a real LLM (Zhipu AI GLM-5 by default).
# Without this, the app runs in echo/demo mode.
# OPENAI_API_KEY=your-zhipu-api-key

# Base URL defaults to Zhipu AI. Override for other OpenAI-compatible APIs.
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Model defaults to glm-5.
# OPENAI_MODEL=glm-5

# LangSmith tracing (optional)
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langgraph-chat
